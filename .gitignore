/.quarto/
**/*.quarto_ipynb*
lectures/_output/

# Salida del libro Quarto (ES+EN): la publica el workflow de GitHub
# Actions en cada push (.github/workflows/publish.yml), ya no se
# comitea para no acumular historial. docs/lectures/, docs/data/ y
# docs/images/ NO se ignoran: no las regenera build.sh, se mantienen
# versionadas como hasta ahora.
/docs/index.html
/docs/presentaciones.html
/docs/proyect_examples.html
/docs/search.json
/docs/sitemap.xml
/docs/robots.txt
/docs/google5c21f1e0999649d3.html
/docs/.nojekyll
/docs/visionbook.css
/docs/site_libs/
/docs/unidades/
/docs/en/
/docs/_freeze/

# El PDF del libro SI se comitea (se compila localmente con ./build-pdf.sh,
# no en CI -- ver pdf-template/README.md) para que el link "Download PDF"
# del sitio (downloads: [pdf] en _quarto.yml) tenga algo que servir.
!/docs/*.pdf

# Quarto a veces escribe figuras/libs de soporte junto al .qmd fuente
# (p. ej. al renderizar a PDF); ya viven en _freeze/, no se duplican.
unidades/**/*_files/
en/unidades/**/*_files/

# Archivos de configuración de entorno (Variables secretas)
.env
.env.local
.env.dev
.env.prod

# Ignorar entornos virtuales de Python
venv/
.venv/
.venv-manim/
env/
ENV/

# Archivos compilados de Python
**/__pycache__/
*.py[cod]
*$py.class

# Archivos del sistema operativo (macOS y Windows)
.DS_Store
.AppleDouble
.LSOverride
Thumds.db
Ehthumbs.db

**/*.quarto_ipynb
