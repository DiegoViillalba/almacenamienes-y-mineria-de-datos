:1},\"geo\":{\"bgcolor\":\"white\",\"landcolor\":\"#E5ECF6\",\"subunitcolor\":\"white\",\"showland\":true,\"showlakes\":true,\"lakecolor\":\"white\"},\"title\":{\"x\":0.05},\"mapbox\":{\"style\":\"light\"},\"margin\":{\"b\":0,\"l\":0,\"r\":0,\"t\":30}}},\"xaxis\":{\"anchor\":\"y\",\"domain\":[0.0,0.94]},\"yaxis\":{\"anchor\":\"x\",\"domain\":[0.0,1.0],\"title\":{\"text\":\"Frecuencia\"}},\"yaxis2\":{\"anchor\":\"x\",\"overlaying\":\"y\",\"side\":\"right\",\"title\":{\"text\":\"Proporci\\u00f3n acumulada\"},\"tickformat\":\".0%\"},\"title\":{\"text\":\"Tiempo de espera: distribuci\\u00f3n y acumulaci\\u00f3n\"}},                        {\"responsive\": true}                    ).then(function(){\n                            \nvar gd = document.getElementById('6d38d90c-cfe2-472b-a7d1-e0b05619f1b2');\nvar x = new MutationObserver(function (mutations, observer) {{\n        var display = window.getComputedStyle(gd).display;\n        if (!display || display === 'none') {{\n            console.log([gd, 'removed!']);\n            Plotly.purge(gd);\n            observer.disconnect();\n        }}\n}});\n\n// Listen for the removal of the full notebook cells\nvar notebookContainer = gd.closest('#notebook-container');\nif (notebookContainer) {{\n    x.observe(notebookContainer, {childList: true});\n}}\n\n// Listen for the clearing of the current output cell\nvar outputEl = gd.closest('.output');\nif (outputEl) {{\n    x.observe(outputEl, {childList: true});\n}}\n\n                        })                };            </script>        </div>\n```\n:::\n:::\n\n\n::: {.callout-warning appearance=\"minimal\"}\nLos tiempos negativos son imposibles bajo la definición habitual y requieren revisión. Los valores de 95 y 120 días son extremos, pero podrían ser casos reales; no deben eliminarse sin evidencia.\n:::\n\n## Datos faltantes\n\nEl porcentaje faltante debe analizarse por variable y por grupos relevantes. Un promedio global puede ocultar que la ausencia se concentra en una fuente, fecha o categoría. La decisión de imputar pertenece al preprocesamiento, pero el EDA debe documentar patrón, magnitud y posibles mecanismos.\n\n## Valores atípicos y anomalías\n\nUn valor atípico es una observación alejada según una regla estadística; una anomalía es un caso incompatible con el proceso esperado. No son sinónimos de error.\n\n| Evidencia | Pregunta | Acción posible |\n|---|---|---|\n| Valor imposible | ¿Contradice el dominio? | Corregir, marcar o excluir con trazabilidad |\n| Valor raro pero posible | ¿Es un segmento real? | Conservar y analizar por separado |\n| Cola extensa | ¿La escala es adecuada? | Transformar o usar medidas robustas |\n| Categoría infrecuente | ¿Es error o nivel real? | Estandarizar o agrupar con criterio |\n\n## Ruta descriptiva del libro\n\nLos siguientes capítulos desarrollan seis perspectivas complementarias:\n\n1. [Medidas de localización](2-3-localizacion.qmd): ¿dónde están los valores?\n2. [Medidas de variabilidad](2-4-variabilidad.qmd): ¿cuánto cambian?\n3. [Medidas de forma](2-5-forma.qmd): ¿cómo son sus colas y simetría?\n4. [Medidas de heterogeneidad](2-6-heterogeneidad.qmd): ¿cambian entre categorías o grupos?\n5. [Medidas de concentración](2-7-concentracion.qmd): ¿quién acumula el total?\n6. [Medidas de correlación](2-9-correlacion.qmd): ¿cómo se asocian dos variables?\n\nCada capítulo teórico está seguido por una práctica reproducible con BigMart.\n\n## Checklist de salida\n\n::: {.callout-important appearance=\"minimal\"}\nUn EDA reproducible debe dejar: diccionario y granularidad, perfil de faltantes, dominios validados, resúmenes con unidades, visualizaciones pertinentes, hallazgos redactados, decisiones justificadas y preguntas pendientes.\n:::\n\n## Ejercicios\n\n1. Clasifique cada variable de BigMart por escala estadística y justifique los casos ambiguos.\n2. Proponga una regla de validación para tres columnas del dataset.\n3. Compare qué información aporta un histograma frente a una ECDF.\n\n## Referencias {.unnumbered}\n\n::: {#refs}\n:::\n\n",
