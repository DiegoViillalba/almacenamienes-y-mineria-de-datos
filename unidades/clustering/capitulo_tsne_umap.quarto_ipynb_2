        "import numpy as np\n",
        "from sklearn.datasets import load_digits\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "\n",
        "# Autoencoder con PyTorch (si disponible) o simulado con sklearn\n",
        "try:\n",
        "    import torch\n",
        "    import torch.nn as nn\n",
        "\n",
        "    digits = load_digits()\n",
        "    X = MinMaxScaler().fit_transform(digits.data).astype(np.float32)\n",
        "    X_tensor = torch.tensor(X)\n",
        "\n",
        "    class Autoencoder(nn.Module):\n",
        "        def __init__(self, latent_dim):\n",
        "            super().__init__()\n",
        "            self.encoder = nn.Sequential(\n",
        "                nn.Linear(64, 32), nn.ReLU(),\n",
        "                nn.Linear(32, latent_dim)\n",
        "            )\n",
        "            self.decoder = nn.Sequential(\n",
        "                nn.Linear(latent_dim, 32), nn.ReLU(),\n",
        "                nn.Linear(32, 64), nn.Sigmoid()\n",
        "            )\n",
        "        def forward(self, x):\n",
        "            return self.decoder(self.encoder(x))\n",
        "\n",
        "    ae = Autoencoder(latent_dim=2)\n",
        "    optimizer = torch.optim.Adam(ae.parameters(), lr=1e-3)\n",
        "    criterion = nn.MSELoss()\n",
        "\n",
        "    for epoch in range(200):\n",
        "        out = ae(X_tensor)\n",
        "        loss = criterion(out, X_tensor)\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        Z = ae.encoder(X_tensor).numpy()\n",
        "\n",
        "    print(f\"Error de reconstrucción final (MSE): {loss.item():.6f}\")\n",
        "    print(f\"Espacio latente: {Z.shape}\")\n",
        "\n",
        "except ImportError:\n",
        "    print(\"PyTorch no disponible. Usando PCA como aproximación.\")\n",
        "    from sklearn.decomposition import PCA\n",
        "    digits = load_digits()\n",
        "    X = MinMaxScaler().fit_transform(digits.data)\n",
        "    pca = PCA(n_components=2)\n",
        "    Z = pca.fit_transform(X)\n",
        "    rec = pca.inverse_transform(Z)\n",
        "    mse = ((X - rec)**2).mean()\n",
        "    print(f\"PCA 2 componentes — MSE de reconstrucción: {mse:.6f}\")\n",
        "    print(f\"Varianza explicada: {pca.explained_variance_ratio_.sum():.4f}\")"
