        "## Autoencoder básico para reducción de dimensionalidad\n",
        "\n",
        "Un autoencoder es una red neuronal que aprende una representación comprimida de los datos. Consiste en un codificador que mapea la entrada a un espacio latente de dimensión reducida, y un decodificador que reconstruye la entrada desde ese espacio latente. El entrenamiento minimiza el error de reconstrucción.\n",
        "\n",
        "```{=html}\n",
        "<div id=\"ae-wrap\" style=\"font-family:Georgia,serif;max-width:700px;margin:2em auto;background:#f9fafc;border:1px solid #d0d7e3;border-radius:10px;padding:20px 24px;box-shadow:0 2px 12px rgba(30,60,120,.07);\">\n",
        "  <div style=\"text-align:center;margin-bottom:12px;\">\n",
        "    <span style=\"font-size:1.05em;font-weight:bold;color:#1a2e45;\">Autoencoder — compresión y reconstrucción</span><br>\n",
        "    <span style=\"font-size:0.81em;color:#666;\">Ajusta la dimensión del espacio latente y observa cómo cambia el error de reconstrucción</span>\n",
        "  </div>\n",
        "  <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap;\">\n",
        "    <label style=\"font-size:0.83em;color:#444;\">Dim. latente = <strong id=\"ae-dv\">2</strong></label>\n",
        "    <input id=\"ae-dsl\" type=\"range\" min=\"1\" max=\"8\" step=\"1\" value=\"2\" style=\"flex:1;min-width:150px;accent-color:#1a3a5c;\">\n",
        "  </div>\n",
        "  <canvas id=\"ae-cv\" style=\"display:block;width:100%;border-radius:6px;border:1px solid #e0e5ed;background:#fff;\"></canvas>\n",
        "  <div id=\"ae-info\" style=\"text-align:center;font-size:0.82em;padding:5px 10px;background:#fff;border:1px solid #e0e5ed;border-radius:5px;margin-top:8px;min-height:22px;\"></div>\n",
        "</div>\n",
        "<script>\n",
        "(function(){\n",
        "  const cv=document.getElementById('ae-cv');\n",
        "  const W=680,H=300,DPR=window.devicePixelRatio||1;\n",
        "  cv.width=W*DPR;cv.height=H*DPR;cv.style.width=W+'px';cv.style.height=H+'px';\n",
        "  const ctx=cv.getContext('2d');ctx.scale(DPR,DPR);\n",
        "  const IN_DIM=16; // simulate 16D input\n",
        "\n",
        "  // Approximate reconstruction error curve (monotone decreasing with latent dim)\n",
        "  function reconErr(d){\n",
        "    // sigmoidal decay: high error at d=1, near 0 at d=8\n",
        "    return 1.0*Math.exp(-0.55*(d-1));\n",
        "  }\n",
        "  // Information preserved\n",
        "  function infoPreserved(d){return 1-reconErr(d);}\n",
        "\n",
        "  function drawArch(latDim){\n",
        "    ctx.clearRect(0,0,W,H);\n",
        "    ctx.fillStyle='#f8f9fb';ctx.fillRect(0,0,W,H);\n",
        "    const layers=[IN_DIM,8,latDim,8,IN_DIM];\n",
        "    const names=['Entrada\\n('+IN_DIM+'D)','Enc 1\\n(8)','Latente\\n('+latDim+'D)','Dec 1\\n(8)','Salida\\n('+IN_DIM+'D)'];\n",
        "    const nL=layers.length;\n",
        "    const lx=Array.from({length:nL},(_,i)=>W*0.08+i*W*0.21);\n",
        "    const maxN=IN_DIM;\n",
        "    const maxH=H*0.7;\n",
        "    const CY=H*0.42;\n",
        "    const rNode=5;\n",
        "\n",
        "    // Draw connections\n",
        "    for(let l=0;l<nL-1;l++){\n",
        "      const n1=Math.min(layers[l],10),n2=Math.min(layers[l+1],10);\n",
        "      for(let i=0;i<n1;i++)for(let j=0;j<n2;j++){\n",
        "        const y1=CY-(n1-1)*9+(i*2)*(n1>1?9/(n1-1)*9:0)/9-n1*4.5+i*9;\n",
        "        const y2=CY-n2*4.5+j*9;\n",
        "        ctx.strokeStyle='rgba(100,120,180,0.08)';ctx.lineWidth=0.8;\n",
        "        ctx.beginPath();ctx.moveTo(lx[l],y1);ctx.lineTo(lx[l+1],y2);ctx.stroke();\n",
        "      }\n",
        "    }\n",
        "\n",
        "    // Draw nodes\n",
        "    layers.forEach((n,li)=>{\n",
        "      const show=Math.min(n,10);\n",
        "      const more=n>10;\n",
        "      const isLatent=li===2;\n",
        "      const col=isLatent?'#f59e0b':li<2?'#2563eb':'#dc2626';\n",
        "      for(let i=0;i<show;i++){\n",
        "        const ny=CY-show*4.5+i*9;\n",
        "        ctx.beginPath();ctx.arc(lx[li],ny,rNode,0,2*Math.PI);\n",
        "        ctx.fillStyle=col+'cc';ctx.fill();\n",
        "        ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.stroke();\n",
        "      }\n",
        "      if(more){ctx.fillStyle=col;ctx.font='10px Georgia,serif';ctx.textAlign='center';ctx.fillText('⋮',lx[li],CY+show*4.5+12);}\n",
        "      const lbl=names[li];\n",
        "      ctx.fillStyle=isLatent?'#92400e':col;ctx.font=(isLatent?'bold ':'')+`10px Georgia,serif`;ctx.textAlign='center';\n",
        "      lbl.split('\\n').forEach((s,si)=>ctx.fillText(s,lx[li],CY+show*4.5+26+si*12));\n",
        "    });\n",
        "\n",
        "    // Bottleneck brace\n",
        "    ctx.strokeStyle='#f59e0b';ctx.lineWidth=2;\n",
        "    ctx.beginPath();ctx.moveTo(lx[2]-18,H*0.12);ctx.lineTo(lx[2]-18,H*0.75);\n",
        "    ctx.moveTo(lx[2]+18,H*0.12);ctx.lineTo(lx[2]+18,H*0.75);ctx.stroke();\n",
        "    ctx.fillStyle='#92400e';ctx.font='bold 9px Georgia,serif';ctx.textAlign='center';\n",
        "    ctx.fillText('cuello',lx[2],H*0.09);\n",
        "\n",
        "    // Error bar chart (right panel)\n",
        "    const bx=W*0.88,by=H*0.15,bh=H*0.7,bw=W*0.06;\n",
        "    const err=reconErr(latDim);\n",
        "    const info=infoPreserved(latDim);\n",
        "    ctx.fillStyle='#dc2626cc';ctx.fillRect(bx-bw,by+bh*(1-err),bw,bh*err);\n",
        "    ctx.fillStyle='#16a34acc';ctx.fillRect(bx,by+bh*(1-info),bw,bh*info);\n",
        "    ctx.strokeStyle='#9aa3b5';ctx.lineWidth=1;\n",
        "    ctx.strokeRect(bx-bw,by,bw,bh);ctx.strokeRect(bx,by,bw,bh);\n",
        "    ctx.fillStyle='#dc2626';ctx.font='9px Georgia,serif';ctx.textAlign='center';\n",
        "    ctx.fillText('Error',bx-bw/2,by+bh+12);ctx.fillText((err*100).toFixed(0)+'%',bx-bw/2,by+bh*(1-err)-4);\n",
        "    ctx.fillStyle='#16a34a';ctx.fillText('Info',bx+bw/2,by+bh+12);ctx.fillText((info*100).toFixed(0)+'%',bx+bw/2,by+bh*(1-info)-4);\n",
        "\n",
        "    // Labels\n",
        "    ctx.fillStyle='#2563eb';ctx.font='bold 10px Georgia,serif';ctx.textAlign='center';\n",
        "    ctx.fillText('Codificador',lx[1],H*0.06);\n",
        "    ctx.fillStyle='#dc2626';ctx.fillText('Decodificador',lx[3],H*0.06);\n",
        "\n",
        "    document.getElementById('ae-info').innerHTML=\n",
        "      `Dimensión latente = <strong>${latDim}</strong> / ${IN_DIM}&ensp;·&ensp;`+\n",
        "      `Error de reconstrucción ≈ <strong style=\"color:#dc2626\">${(err*100).toFixed(0)}%</strong>&ensp;·&ensp;`+\n",
        "      `Información preservada ≈ <strong style=\"color:#16a34a\">${(info*100).toFixed(0)}%</strong>`;\n",
        "  }\n",
        "\n",
        "  document.getElementById('ae-dsl').addEventListener('input',function(){\n",
        "    const d=parseInt(this.value);\n",
        "    document.getElementById('ae-dv').textContent=d;\n",
        "    drawArch(d);\n",
        "  });\n",
        "  drawArch(2);\n",
        "})();\n",
        "</script>\n",
        "```"
