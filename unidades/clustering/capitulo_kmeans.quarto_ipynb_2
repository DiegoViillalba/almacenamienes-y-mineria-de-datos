        "      cents=Array.from({length:k},(_,ci)=>{const cl=PTS.filter((_,i)=>nl[i]===ci);return cl.length?[cl.reduce((s,p)=>s+p[0],0)/cl.length,cl.reduce((s,p)=>s+p[1],0)/cl.length]:cents[ci];});\n",
        "      labels=nl;\n",
        "    }\n",
        "    const wcss=PTS.reduce((s,p,i)=>s+dist2(p,cents[labels[i]]),0);\n",
        "    return{labels,cents,wcss};\n",
        "  }\n",
        "\n",
        "  function silScore(labels,k){\n",
        "    const sils=PTS.map((p,i)=>{\n",
        "      const same=PTS.filter((_,j)=>j!==i&&labels[j]===labels[i]);\n",
        "      const a=same.length?same.reduce((s,q)=>s+Math.sqrt(dist2(p,q)),0)/same.length:0;\n",
        "      let b=Infinity;\n",
        "      for(let c=0;c<k;c++){if(c===labels[i])continue;const cl=PTS.filter((_,j)=>labels[j]===c);if(!cl.length)continue;const mb=cl.reduce((s,q)=>s+Math.sqrt(dist2(p,q)),0)/cl.length;if(mb<b)b=mb;}\n",
        "      return(b-a)/Math.max(a,b);\n",
