        "from sklearn.datasets import make_blobs\n",
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(42)\n",
        "X, _ = make_blobs(n_samples=200, centers=3, cluster_std=0.8, random_state=42)\n",
        "\n",
        "# Agregar outliers\n",
        "X = np.vstack([X, [[10, 10], [10, -10], [-10, 10]]])\n",
        "\n",
        "from sklearn.cluster import KMeans\n",
        "\n",
        "km = KMeans(n_clusters=3, random_state=0, n_init=10)\n",
        "labels_km = km.fit_predict(X)\n",
        "print(\"K-Means centroides:\\n\", km.cluster_centers_.round(3))\n",
        "\n",
        "# Implementación simple de K-Medoids\n",
        "def kmedoids_simple(X, k, seed=0):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    idx = rng.choice(len(X), k, replace=False)\n",
        "    medoids = list(idx)\n",
        "\n",
        "    for _ in range(100):\n",
        "        D = np.array([[np.linalg.norm(X[i] - X[m]) for m in medoids] for i in range(len(X))])\n",
        "        labels = D.argmin(axis=1)\n",
        "        new_medoids = []\n",
        "        for j in range(k):\n",
        "            cluster = np.where(labels == j)[0]\n",
        "            if len(cluster) == 0:\n",
        "                new_medoids.append(medoids[j])\n",
        "                continue\n",
        "            sub_D = np.array([[np.linalg.norm(X[a] - X[b]) for b in cluster] for a in cluster])\n",
        "            new_medoids.append(int(cluster[sub_D.sum(axis=1).argmin()]))\n",
        "        if new_medoids == medoids:\n",
        "            break\n",
        "        medoids = new_medoids\n",
        "    return np.array(medoids), labels\n",
        "\n",
        "medoids_idx, labels_kmed = kmedoids_simple(X, 3)\n",
        "print(\"\\nK-Medoids medoides (índices):\", medoids_idx)\n",
        "print(\"K-Medoids medoides (valores):\\n\", X[medoids_idx].round(3))"
