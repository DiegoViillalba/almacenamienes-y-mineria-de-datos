        "```{=html}\n",
        "<div id=\"elbow-wrap\" style=\"font-family:Georgia,serif;max-width:700px;margin:2em auto;background:#f9fafc;border:1px solid #d0d7e3;border-radius:10px;padding:20px 24px;box-shadow:0 2px 12px rgba(30,60,120,.07);\">\n",
        "  <div style=\"text-align:center;margin-bottom:12px;\">\n",
        "    <span style=\"font-size:1.05em;font-weight:bold;color:#1a2e45;\">Método del codo y silueta — selección de k</span><br>\n",
        "    <span style=\"font-size:0.81em;color:#666;\">Haz clic en un k para ver el clustering y sus métricas</span>\n",
        "  </div>\n",
        "  <canvas id=\"elbow-cv\" style=\"display:block;width:100%;border-radius:6px;border:1px solid #e0e5ed;background:#fff;cursor:pointer;\"></canvas>\n",
        "  <div id=\"elbow-info\" style=\"text-align:center;font-size:0.82em;padding:5px 10px;background:#fff;border:1px solid #e0e5ed;border-radius:5px;margin-top:10px;min-height:22px;\"></div>\n",
        "</div>\n",
        "<script>\n",
        "(function(){\n",
        "  const PTS=[\n",
        "    [1.0,1.2],[1.4,0.8],[0.8,1.5],[1.2,0.7],[1.6,1.4],[0.9,0.9],[1.3,1.7],[1.1,1.0],[1.5,0.6],[0.7,1.3],\n",
        "    [1.8,1.9],[0.5,1.1],[1.0,1.5],[1.3,1.2],[0.8,0.5],[1.7,1.1],[0.6,0.8],[1.4,1.6],[1.9,1.3],[0.4,1.4],\n",
        "    [4.5,4.8],[4.9,4.2],[4.2,5.0],[4.7,4.4],[5.2,4.7],[4.3,4.0],[4.8,5.1],[4.4,4.3],[5.0,4.1],[4.1,4.5],\n",
        "    [5.3,4.9],[4.0,4.1],[4.6,5.2],[5.1,4.6],[4.3,3.9],[4.7,4.2],[5.4,4.8],[3.9,4.3],[4.5,5.0],[5.0,4.5],\n",
        "    [7.8,1.8],[7.2,2.2],[8.1,1.3],[7.5,2.0],[7.0,1.7],[7.9,2.4],[7.3,1.1],[7.6,2.1],[8.2,2.0],[7.1,1.5],\n",
        "    [7.4,2.5],[7.7,1.3],[8.0,1.9],[7.2,2.3],[7.5,1.6],[7.8,2.2],[7.0,1.2],[7.6,1.8],[8.1,2.3],[7.3,1.9]\n",
        "  ];\n",
        "  const N=PTS.length;\n",
        "  const COLS=['#2563eb','#dc2626','#16a34a','#f59e0b','#7c3aed','#0891b2'];\n",
        "  const cv=document.getElementById('elbow-cv');\n",
        "  const W=680,H=400,DPR=window.devicePixelRatio||1;\n",
        "  cv.width=W*DPR;cv.height=H*DPR;cv.style.width=W+'px';cv.style.height=H+'px';\n",
        "  const ctx=cv.getContext('2d');ctx.scale(DPR,DPR);\n",
        "\n",
        "  function dist2(a,b){return(a[0]-b[0])**2+(a[1]-b[1])**2;}\n",
        "  function kmeans(k){\n",
        "    let cents=[];\n",
        "    const taken=new Set();\n",
        "    while(cents.length<k){const r=Math.floor(Math.random()*N);if(!taken.has(r)){taken.add(r);cents.push([...PTS[r]]);}}\n",
        "    let labels=new Array(N).fill(0);\n",
        "    for(let it=0;it<50;it++){\n",
