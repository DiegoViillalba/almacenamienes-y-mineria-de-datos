        "from sklearn.datasets import make_blobs\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import silhouette_score\n",
        "\n",
        "X, y_true = make_blobs(\n",
        "    n_samples=400, centers=[[-3, -3], [0, 0], [3, 3], [0, 5]],\n",
        "    cluster_std=[0.8, 1.0, 0.7, 0.9], random_state=42\n",
        ")\n",
        "\n",
        "X_std = StandardScaler().fit_transform(X)\n",
        "\n",
        "km = KMeans(\n",
        "    n_clusters=4,\n",
        "    init=\"k-means++\",\n",
        "    n_init=20,\n",
        "    max_iter=300,\n",
        "    random_state=42\n",
        ")\n",
        "labels = km.fit_predict(X_std)\n",
        "\n",
        "print(\"Inercia (WCSS):\", round(km.inertia_, 4))\n",
        "print(\"Iteraciones hasta convergencia:\", km.n_iter_)\n",
        "print(\"Silueta:\", round(silhouette_score(X_std, labels), 4))\n",
        "print(\"Distribución:\", np.bincount(labels))"
