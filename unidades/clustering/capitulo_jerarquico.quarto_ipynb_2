        "import matplotlib.pyplot as plt\n",
        "from scipy.cluster.hierarchy import linkage, dendrogram, fcluster\n",
        "import numpy as np\n",
        "from sklearn.datasets import make_blobs\n",
        "\n",
        "X, _ = make_blobs(n_samples=80, centers=4, cluster_std=0.7, random_state=0)\n",
        "\n",
        "Z = linkage(X, method=\"ward\")\n",
        "\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4))\n",
        "\n",
        "dendrogram(Z, ax=ax1, truncate_mode=\"lastp\", p=20, leaf_rotation=90,\n",
        "           color_threshold=0.7 * max(Z[:, 2]))\n",
        "ax1.set_title(\"Dendrograma (Ward)\")\n",
        "ax1.set_xlabel(\"Muestra o grupo\")\n",
        "ax1.set_ylabel(\"Distancia\")\n",
        "\n",
        "labels = fcluster(Z, t=4, criterion=\"maxclust\")\n",
        "ax2.scatter(X[:, 0], X[:, 1], c=labels, cmap=\"tab10\", s=30, edgecolors=\"white\", linewidths=0.5)\n",
        "ax2.set_title(\"Partición con k=4 grupos\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
