        "import numpy as np\n",
        "from sklearn.neighbors import NearestNeighbors\n",
        "from sklearn.datasets import make_moons\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "X, _ = make_moons(n_samples=300, noise=0.05, random_state=42)\n",
        "\n",
        "k = 5\n",
        "nbrs = NearestNeighbors(n_neighbors=k).fit(X)\n",
        "distances, _ = nbrs.kneighbors(X)\n",
        "k_dist = np.sort(distances[:, -1])[::-1]\n",
        "\n",
        "plt.figure(figsize=(7, 3))\n",
        "plt.plot(k_dist, color=\"#1a3a5c\", linewidth=2)\n",
        "plt.axhline(0.15, color=\"#f59e0b\", linestyle=\"--\", label=\"ε = 0.15 (sugerido)\")\n",
        "plt.xlabel(\"Puntos ordenados por k-distancia\")\n",
        "plt.ylabel(\"k-distancia\")\n",
        "plt.title(f\"Gráfico {k}-distancia para seleccionar ε\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
