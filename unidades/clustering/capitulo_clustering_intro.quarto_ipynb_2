        "```{=html}\n",
        "<div id=\"sil-wrap\" style=\"font-family:Georgia,serif;max-width:700px;margin:2em auto;background:#f9fafc;border:1px solid #d0d7e3;border-radius:10px;padding:20px 24px;box-shadow:0 2px 12px rgba(30,60,120,.07);\">\n",
        "  <div style=\"text-align:center;margin-bottom:12px;\">\n",
        "    <span style=\"font-size:1.05em;font-weight:bold;color:#1a2e45;\">Índice de silueta — visualizador</span><br>\n",
        "    <span style=\"font-size:0.81em;color:#666;\">Ajusta el número de grupos k y observa cómo cambia la silueta de cada punto</span>\n",
        "  </div>\n",
        "  <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap;\">\n",
        "    <label style=\"font-size:0.83em;color:#444;\">k = <strong id=\"sk-v\">3</strong></label>\n",
        "    <input id=\"sk-sl\" type=\"range\" min=\"2\" max=\"7\" step=\"1\" value=\"3\" style=\"flex:1;min-width:150px;accent-color:#1a3a5c;\">\n",
        "  </div>\n",
        "  <div id=\"sil-info\" style=\"text-align:center;font-size:0.82em;padding:5px 10px;background:#fff;border:1px solid #e0e5ed;border-radius:5px;margin-bottom:10px;min-height:22px;\"></div>\n",
        "  <canvas id=\"sil-cv\" style=\"display:block;width:100%;border-radius:6px;border:1px solid #e0e5ed;background:#fff;\"></canvas>\n",
        "</div>\n",
        "<script>\n",
        "(function(){\n",
        "  // Pre-generated 60-point blob dataset (3 natural clusters)\n",
        "  const PTS=[\n",
        "    [0.8,1.2],[1.2,0.9],[0.5,1.5],[1.0,0.7],[1.4,1.3],[0.7,0.8],[1.1,1.6],[0.9,1.0],[1.3,0.6],[0.6,1.1],\n",
        "    [1.5,1.8],[0.4,1.3],[1.0,1.4],[1.2,1.1],[0.8,0.6],[1.6,1.0],[0.5,0.9],[1.3,1.5],[0.7,1.3],[1.1,0.8],\n",
        "    [4.2,4.5],[4.8,4.1],[3.9,4.7],[4.5,4.3],[5.0,4.6],[4.1,3.9],[4.7,4.8],[4.3,4.2],[4.6,3.8],[4.0,4.4],\n",
        "    [5.1,4.7],[3.8,4.0],[4.4,4.9],[4.9,4.5],[4.2,3.7],[4.6,4.1],[3.9,4.6],[4.8,4.3],[4.1,4.8],[4.5,4.0],\n",
        "    [7.5,1.5],[7.0,2.0],[7.8,1.2],[7.3,1.8],[6.8,1.6],[7.6,2.2],[7.1,1.0],[7.4,1.9],[7.7,1.4],[6.9,2.1],\n",
        "    [8.0,1.7],[7.2,1.3],[7.5,2.3],[7.0,1.1],[7.8,1.8],[7.3,2.0],[6.8,1.4],[7.6,1.6],[7.1,2.2],[7.4,1.2]\n",
        "  ];\n",
        "  const N=PTS.length;\n",
        "  const cv=document.getElementById('sil-cv');\n",
        "  const W=680,H=300,DPR=window.devicePixelRatio||1;\n",
        "  cv.width=W*DPR;cv.height=H*DPR;cv.style.width=W+'px';cv.style.height=H+'px';\n",
        "  const ctx=cv.getContext('2d');ctx.scale(DPR,DPR);\n",
        "  const COLS=['#2563eb','#dc2626','#16a34a','#f59e0b','#7c3aed','#0891b2','#be185d'];\n",
        "\n",
        "  function dist2(a,b){return Math.sqrt((a[0]-b[0])**2+(a[1]-b[1])**2);}\n",
        "\n",
        "  function kmeans(k,iters=40){\n",
        "    let cents=PTS.slice(0,k).map(p=>[...p]);\n",
        "    let labels=new Array(N).fill(0);\n",
        "    for(let it=0;it<iters;it++){\n",
        "      labels=PTS.map(p=>{let bi=0,bd=Infinity;cents.forEach((c,i)=>{const d=dist2(p,c);if(d<bd){bd=d;bi=i;}});return bi;});\n",
        "      cents=Array.from({length:k},(_,ci)=>{\n",
        "        const cl=PTS.filter((_,i)=>labels[i]===ci);\n",
        "        if(!cl.length)return cents[ci];\n",
        "        return[cl.reduce((s,p)=>s+p[0],0)/cl.length,cl.reduce((s,p)=>s+p[1],0)/cl.length];\n",
        "      });\n",
        "    }\n",
        "    return{labels,cents};\n",
        "  }\n",
        "\n",
        "  function silhouette(labels,k){\n",
        "    return PTS.map((p,i)=>{\n",
        "      const same=PTS.filter((_,j)=>j!==i&&labels[j]===labels[i]);\n",
        "      const a=same.length?same.reduce((s,q)=>s+dist2(p,q),0)/same.length:0;\n",
        "      let b=Infinity;\n",
        "      for(let c=0;c<k;c++){\n",
        "        if(c===labels[i])continue;\n",
        "        const cl=PTS.filter((_,j)=>labels[j]===c);\n",
        "        if(!cl.length)continue;\n",
        "        const mb=cl.reduce((s,q)=>s+dist2(p,q),0)/cl.length;\n",
        "        if(mb<b)b=mb;\n",
        "      }\n",
        "      return(b-a)/Math.max(a,b);\n",
        "    });\n",
        "  }\n",
        "\n",
        "  function draw(k){\n",
        "    const{labels,cents}=kmeans(k);\n",
        "    const sils=silhouette(labels,k);\n",
        "    const avgSil=sils.reduce((s,v)=>s+v,0)/N;\n",
        "    ctx.clearRect(0,0,W,H);\n",
        "\n",
        "    // Left: scatter\n",
        "    const LP={l:44,r:W/2-8,t:20,b:H-30};\n",
        "    const LW=LP.r-LP.l,LH=LP.b-LP.t;\n",
        "    const xMn=0,xMx=9,yMn=0,yMx=6;\n",
        "    const sx=x=>LP.l+(x-xMn)/xMx*LW,sy=y=>LP.t+LH-(y-yMn)/yMx*LH;\n",
        "    ctx.fillStyle='#f8f9fb';ctx.fillRect(LP.l,LP.t,LW,LH);\n",
        "    ctx.strokeStyle='#9aa3b5';ctx.lineWidth=1;\n",
        "    ctx.strokeRect(LP.l,LP.t,LW,LH);\n",
        "    PTS.forEach((p,i)=>{\n",
        "      ctx.beginPath();ctx.arc(sx(p[0]),sy(p[1]),5,0,2*Math.PI);\n",
        "      ctx.fillStyle=COLS[labels[i]]+'cc';ctx.fill();\n",
        "      ctx.strokeStyle='#fff';ctx.lineWidth=1;ctx.stroke();\n",
        "    });\n",
        "    cents.forEach((c,i)=>{\n",
        "      ctx.beginPath();ctx.arc(sx(c[0]),sy(c[1]),9,0,2*Math.PI);\n",
        "      ctx.fillStyle=COLS[i];ctx.fill();\n",
        "      ctx.strokeStyle='#fff';ctx.lineWidth=2.5;ctx.stroke();\n",
        "      ctx.fillStyle='#fff';ctx.font='bold 10px Georgia,serif';ctx.textAlign='center';\n",
        "      ctx.fillText(i+1,sx(c[0]),sy(c[1])+3);\n",
        "    });\n",
        "    ctx.fillStyle='#1a2e45';ctx.font='bold 11px Georgia,serif';ctx.textAlign='center';\n",
        "    ctx.fillText('Scatter (k='+k+')',LP.l+LW/2,LP.t-6);\n",
        "\n",
        "    // Right: silhouette bars\n",
        "    const RP={l:W/2+8,r:W-10,t:20,b:H-30};\n",
        "    const RW=RP.r-RP.l,RH=RP.b-RP.t;\n",
        "    ctx.fillStyle='#f8f9fb';ctx.fillRect(RP.l,RP.t,RW,RH);\n",
        "    ctx.strokeStyle='#9aa3b5';ctx.lineWidth=1;ctx.strokeRect(RP.l,RP.t,RW,RH);\n",
        "\n",
        "    // Sort by cluster then by silhouette\n",
        "    const sorted=sils.map((s,i)=>({s,c:labels[i]})).sort((a,b)=>a.c-b.c||b.s-a.s);\n",
        "    const bh=RH/N;\n",
        "    const midX=RP.l+RW/2;\n",
        "    sorted.forEach((d,i)=>{\n",
        "      const bw=Math.abs(d.s)*RW*0.45;\n",
        "      const by=RP.t+i*bh;\n",
        "      ctx.fillStyle=COLS[d.c]+(d.s<0?'88':'cc');\n",
        "      if(d.s>=0)ctx.fillRect(midX,by,bw,bh-0.5);\n",
        "      else ctx.fillRect(midX-bw,by,bw,bh-0.5);\n",
        "    });\n",
        "    ctx.strokeStyle='#9aa3b5';ctx.lineWidth=1;\n",
        "    ctx.beginPath();ctx.moveTo(midX,RP.t);ctx.lineTo(midX,RP.b);ctx.stroke();\n",
        "    ctx.fillStyle='#888';ctx.font='9px Georgia,serif';ctx.textAlign='center';\n",
        "    ctx.fillText('-1',RP.l+4,RP.b+12);ctx.fillText('0',midX,RP.b+12);ctx.fillText('1',RP.r-4,RP.b+12);\n",
        "    ctx.fillStyle='#1a2e45';ctx.font='bold 11px Georgia,serif';ctx.textAlign='center';\n",
        "    ctx.fillText('Siluetas por punto',RP.l+RW/2,RP.t-6);\n",
        "\n",
        "    document.getElementById('sil-info').innerHTML=\n",
        "      `k = <strong>${k}</strong>&ensp;·&ensp;`+\n",
        "      `Silueta media = <strong style=\"color:${avgSil>0.5?'#16a34a':avgSil>0.25?'#ca8a04':'#dc2626'}\">${avgSil.toFixed(3)}</strong>&ensp;·&ensp;`+\n",
        "      `Puntos negativos = <strong>${sils.filter(s=>s<0).length}</strong>`;\n",
        "  }\n",
        "\n",
        "  document.getElementById('sk-sl').addEventListener('input',function(){\n",
        "    const k=parseInt(this.value);\n",
        "    document.getElementById('sk-v').textContent=k;\n",
        "    draw(k);\n",
        "  });\n",
        "  draw(3);\n",
        "})();\n",
        "</script>\n",
        "```\n",
        "\n",
        "## Evaluación con etiquetas verdaderas\n",
        "\n",
        "Cuando se dispone de etiquetas externas —por ejemplo en un experimento controlado— es posible medir cuánto se parece la partición encontrada a la partición de referencia. Estas métricas son externas.\n",
        "\n",
        "### Índice de Rand ajustado\n",
        "\n",
        "El índice de Rand considera todos los pares de observaciones y cuenta cuántos pares están en el mismo grupo en ambas particiones, o en grupos distintos en ambas [@hubert1985].\n",
        "\n",
        "::: {.callout-note appearance=\"minimal\"}\n",
        "Definición. El índice de Rand ajustado (ARI) corrige el índice de Rand por la coincidencia esperada bajo asignación aleatoria:\n",
        "$$\n",
        "\\text{ARI} = \\frac{\\text{RI} - \\mathbb{E}[\\text{RI}]}{\\max(\\text{RI}) - \\mathbb{E}[\\text{RI}]}.\n",
        "$$ {#eq-ari}\n",
        ":::\n",
        "\n",
        "El ARI está en $[-1,1]$. Un valor de 1 indica concordancia perfecta; un valor de 0 indica lo esperado por azar. Se prefiere sobre el índice de Rand sin ajustar porque no crece artificialmente con $n$ o $k$."
