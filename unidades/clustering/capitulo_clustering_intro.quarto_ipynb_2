        "import numpy as np\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics.pairwise import euclidean_distances, manhattan_distances, cosine_distances\n",
        "\n",
        "rng = np.random.default_rng(42)\n",
        "X = rng.normal(loc=[0, 0], scale=[1, 100], size=(50, 2))  # escala muy distinta\n",
        "\n",
        "X_std = StandardScaler().fit_transform(X)\n",
        "\n",
        "print(\"Sin escalar — distancia media:\", euclidean_distances(X).mean().round(2))\n",
        "print(\"Escalado    — distancia media:\", euclidean_distances(X_std).mean().round(2))"
