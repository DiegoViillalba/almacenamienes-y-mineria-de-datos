        "#| echo: false\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# 1. Datos sintéticos\n",
        "n = 5000\n",
        "outlet_type = np.random.choice(\n",
