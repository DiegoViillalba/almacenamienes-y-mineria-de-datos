        "    barmode=\"overlay\",\n",
        "    opacity=0.65,\n",
        "    nbins=40,\n",
        "    title=\"MCAR: la muestra observada se parece a la distribución original\"\n",
        ")\n",
        "\n",
        "fig.update_layout(\n",
        "    height=450,\n",
        "    xaxis_title=\"Item_Weight\",\n",
        "    yaxis_title=\"Frecuencia\",\n",
