    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def resolver_ventas(campos_solicitados, region=None, trimestre=None, departamento=None):\n",
        "    df = data_mart\n",
        "    if region:\n",
        "        df = df[df[\"region\"] == region]\n",
        "    if trimestre:\n",
        "        df = df[df[\"trimestre\"] == trimestre]\n",
        "    if departamento:\n",
        "        df = df[df[\"departamento\"] == departamento]\n",
        "\n",
        "    agregado = (\n",
        "        df.groupby([\"region\", \"trimestre\", \"departamento\"], as_index=False)[\"monto_venta\"]\n",
        "        .sum()\n",
        "        .rename(columns={\"monto_venta\": \"total_ventas\"})\n",
        "    )\n",
        "    return agregado[campos_solicitados].to_dict(orient=\"records\")\n",
        "\n",
        "# El cliente REST recibía region, trimestre, departamento y total_ventas.\n",
        "# El cliente GraphQL pide solo lo que necesita:\n",
        "resolver_ventas([\"departamento\", \"total_ventas\"], region=\"Centro\", trimestre=\"T2\")"
      ],
