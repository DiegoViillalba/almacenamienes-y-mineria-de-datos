        "      <div class=\"dm-title\">fact_ventas</div>\n",
        "      <div class=\"dm-small\">id_tiempo (FK)<br>id_ubicacion (FK)<br>id_departamento (FK)<br><strong>monto_venta</strong><br><strong>unidades</strong></div>\n",
        "    </div>\n",
        "    <div class=\"dm-card\" style=\"border-top:4px solid var(--dm-green);\">\n",
        "      <div class=\"dm-title\">dim_ubicacion</div>\n",
