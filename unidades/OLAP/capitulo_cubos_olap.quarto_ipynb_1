    "---\n",
    "title: \"Computación de cubos de datos OLAP\"\n",
    "subtitle: \"Un enfoque técnico y reproducible\"\n",
    "author: \"Diego Villalba\"\n",
    "date: today\n",
    "format:\n",
    "  revealjs:\n",
    "    theme: unam-theme.scss\n",
    "    slide-number: true\n",
