    "import numpy as np\n",
    "import plotly.graph_objects as go\n",
    "from scipy import stats\n",
    "\n",
    "xs = np.linspace(sales.min(), sales.max(), 400)\n",
    "kde = stats.gaussian_kde(sales)\n",
    "\n",
    "fig = go.Figure()\n",
    "\n",
    "# Histograma en densidad\n",
    "fig.add_trace(\n",
    "    go.Histogram(\n",
    "        x=sales,\n",
    "        nbinsx=40,\n",
    "        histnorm=\"probability density\",\n",
    "        opacity=0.6,\n",
    "        name=\"Histograma\"\n",
    "    )\n",
    ")\n",
    "\n",
    "# Curva KDE\n",
    "fig.add_trace(\n",
    "    go.Scatter(\n",
    "        x=xs,\n",
    "        y=kde(xs),\n",
    "        mode=\"lines\",\n",
    "        name=\"Densidad estimada\",\n",
    "        line=dict(width=2)\n",
    "    )\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    title=\"Histograma y densidad estimada de Item_Outlet_Sales\",\n",
    "    xaxis_title=\"Item_Outlet_Sales\",\n",
    "    yaxis_title=\"Densidad\",\n",
    "    bargap=0.02,\n",
    "    height=500,\n",
    "    width=900\n",
    ")\n",
    "\n",
    "fig.show()"
   ]
  },
