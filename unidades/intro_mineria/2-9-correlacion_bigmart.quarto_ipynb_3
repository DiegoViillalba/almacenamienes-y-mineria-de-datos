        "df = pd.read_csv(DATA_PATH)\n",
        "\n",
        "if \"Item_Fat_Content\" in df.columns:\n",
        "    df[\"Item_Fat_Content\"] = (\n",
        "        df[\"Item_Fat_Content\"]\n",
        "        .replace({\n",
        "            \"LF\": \"Low Fat\",\n",
        "            \"low fat\": \"Low Fat\",\n",
        "            \"reg\": \"Regular\"\n",
        "        })\n",
        "    )\n",
        "\n",
        "df.head()"
      ],
