      "source": [
        "if {\"Item_Weight\", \"Item_Outlet_Sales\"}.issubset(df.columns):\n",
        "    fig = px.scatter(\n",
        "        df,\n",
        "        x=\"Item_Weight\",\n",
        "        y=\"Item_Outlet_Sales\",\n",
