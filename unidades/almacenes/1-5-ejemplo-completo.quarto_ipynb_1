    "---\n",
    "\n",
    "## 3. Homologación e integración de fuentes (Staging Integrado)\n",
    "\n",
    "En Kimball, la integración lógica se garantiza mediante **dimensiones conformadas** y una **bus matrix**. Antes de construir dimensiones y hechos, se unifican las fuentes POS y App.\n",
    "\n",
    "### 3.1 Integración de encabezados y líneas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "fba6f6b1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Aviso: 13 encabezados de pedido duplicados (reenvíos); se conserva el más reciente por 'fecha'.\n"
     ]
    }
   ],
   "source": [
    "# Unificar encabezados y líneas\n",
    "pedidos = pd.concat([ped_pos, ped_app], ignore_index=True)\n",
    "lineas  = pd.concat([lin_pos, lin_app], ignore_index=True)\n",
    "\n",
    "# Normalizaciones\n",
    "pedidos[\"canal\"] = pedidos[\"canal\"].str.upper()\n",
    "\n",
    "# --- CLAVE ÚNICA GLOBAL (DW) ---\n",
    "# Si order_id puede repetirse entre POS y APP, usamos (canal, order_id).\n",
    "# Creamos un identificador único: order_uid\n",
    "pedidos[\"order_uid\"] = pedidos[\"canal\"].astype(str) + \"-\" + pedidos[\"order_id\"].astype(str)\n",
    "\n",
    "# Las líneas no traen canal; se lo pegamos desde el header con un join previo (por order_id y canal si aplica)\n",
    "# Si tus líneas sí traen canal, úsalo; si no, asumimos que lineas_pos -> POS y lineas_app -> APP\n",
    "lin_pos_ = lin_pos.copy()\n",
    "lin_pos_[\"canal\"] = \"POS\"\n",
    "lin_app_ = lin_app.copy()\n",
    "lin_app_[\"canal\"] = \"APP\"\n",
    "\n",
    "lineas = pd.concat([lin_pos_, lin_app_], ignore_index=True)\n",
    "lineas[\"canal\"] = lineas[\"canal\"].str.upper()\n",
    "lineas[\"order_uid\"] = lineas[\"canal\"].astype(str) + \"-\" + lineas[\"order_id\"].astype(str)\n",
    "\n",
    "# Flags\n",
    "lineas[\"promo_codigo\"] = lineas.get(\"promo_codigo\", pd.Series([\"NA\"]*len(lineas))).fillna(\"NA\")\n",
    "lineas[\"cancelado_flag\"] = lineas.get(\"cancelado_flag\", 0)\n",
    "lineas[\"cancelado_flag\"] = lineas[\"cancelado_flag\"].fillna(0).astype(int)\n",
    "\n",
    "# Encabezados duplicados (reenvíos desde origen): se conserva el más reciente.\n",
    "# En una extracción real, el mismo pedido puede llegar más de una vez (reintentos,\n",
    "# recargas parciales); quedarse con la versión más reciente por 'fecha' es la\n",
    "# convención más simple, documentada aquí para que sea auditable.\n",
    "if pedidos[\"order_uid\"].duplicated().any():\n",
    "    n_dup = pedidos[\"order_uid\"].duplicated().sum()\n",
    "    print(f\"Aviso: {n_dup} encabezados de pedido duplicados (reenvíos); se conserva el más reciente por 'fecha'.\")\n",
    "    pedidos = pedidos.sort_values(\"fecha\").drop_duplicates(subset=[\"order_uid\"], keep=\"last\")\n",
    "\n",
    "# Integración header + lines a granularidad línea usando order_uid\n",
    "# (order_id y canal ya vienen en 'lineas'; se descartan de 'pedidos' para evitar sufijos _x/_y)\n",
    "stg = lineas.merge(pedidos.drop(columns=[\"order_id\", \"canal\"]), on=[\"order_uid\"], how=\"left\", validate=\"m:1\")\n",
    "\n",
    "# Chequeo de integridad\n",
    "if stg[\"fecha\"].isna().any():\n",
    "    bad = stg[stg[\"fecha\"].isna()][[\"order_id\",\"order_uid\",\"line_num\",\"canal\"]].head(10)\n",
    "    raise ValueError(f\"Existen líneas sin encabezado de pedido asociado. Ejemplos:\\n{bad}\")"
   ]
