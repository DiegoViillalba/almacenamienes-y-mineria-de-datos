    "def build_dim_type1(df: pd.DataFrame, natural_key: str, attrs: list[str], sk_name: str) -> pd.DataFrame:\n",
    "    out = df[[natural_key] + attrs].drop_duplicates().reset_index(drop=True)\n",
    "    out.insert(0, sk_name, np.arange(1, len(out)+1, dtype=int))\n",
    "    return out\n",
    "\n",
    "# Dimensiones básicas\n",
    "dim_canal = pd.DataFrame({\"canal\": [\"POS\",\"APP\"]})\n",
    "dim_canal.insert(0, \"canal_key\", [1,2])\n",
    "\n",
    "# Metodo de pago: si no existe en staging, se crea \"NA\"\n",
    "if \"metodo_pago\" not in stg.columns:\n",
    "    stg[\"metodo_pago\"] = \"NA\"\n",
    "dim_metodo_pago = pd.DataFrame({\"metodo_pago\": sorted(stg[\"metodo_pago\"].fillna(\"NA\").unique())})\n",
    "dim_metodo_pago.insert(0, \"metodo_pago_key\", np.arange(1, len(dim_metodo_pago)+1, dtype=int))\n",
    "\n",
    "# Promoción\n",
    "if promociones is None:\n",
    "    # Mínimo viable: solo códigos observados\n",
    "    dim_promocion = pd.DataFrame({\"promo_codigo\": sorted(stg[\"promo_codigo\"].fillna(\"NA\").unique())})\n",
    "else:\n",
    "    # Con catálogo maestro: se prioriza catálogo, pero garantizamos NA\n",
    "    dim_promocion = promociones.copy()\n",
    "    if \"promo_codigo\" not in dim_promocion.columns:\n",
    "        raise ValueError(\"promociones.csv debe incluir 'promo_codigo'\")\n",
    "    if \"NA\" not in set(dim_promocion[\"promo_codigo\"].astype(str).unique()):\n",
    "        dim_promocion = pd.concat([pd.DataFrame({\"promo_codigo\":[\"NA\"]}), dim_promocion], ignore_index=True)\n",
    "\n",
    "dim_promocion[\"promo_codigo\"] = dim_promocion[\"promo_codigo\"].astype(str).fillna(\"NA\")\n",
    "dim_promocion = dim_promocion.drop_duplicates(subset=[\"promo_codigo\"]).reset_index(drop=True)\n",
    "dim_promocion.insert(0, \"promocion_key\", np.arange(1, len(dim_promocion)+1, dtype=int))\n",
    "dim_promocion.head()"
   ]
