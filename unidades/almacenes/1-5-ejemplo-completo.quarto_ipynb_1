    "lin_pos = read_csv(DATA_DIR / \"lineas_pos.csv\")\n",
    "lin_app = read_csv(DATA_DIR / \"lineas_app.csv\")\n",
    "\n",
    "# Promociones es opcional\n",
    "prom_path = DATA_DIR / \"promociones.csv\"\n",
    "promociones = read_csv(prom_path) if prom_path.exists() else None\n",
