    "def assert_columns(df: pd.DataFrame, required: list[str], name: str):\n",
    "    missing = [c for c in required if c not in df.columns]\n",
    "    if missing:\n",
    "        raise ValueError(f\"[{name}] Faltan columnas requeridas: {missing}\")\n",
    "\n",
    "# Esquema mínimo\n",
    "assert_columns(clientes,  [\"cliente_id\", \"fecha_alta\"], \"clientes\")\n",
    "assert_columns(productos, [\"sku\", \"nombre\", \"categoria\"], \"productos\")\n",
    "assert_columns(sucursales,[\"sucursal_id\", \"nombre\", \"zona\"], \"sucursales\")\n",
    "\n",
    "assert_columns(ped_pos, [\"order_id\",\"fecha\",\"cliente_id\",\"sucursal_id\",\"canal\"], \"pedidos_pos\")\n",
    "assert_columns(ped_app, [\"order_id\",\"fecha\",\"cliente_id\",\"sucursal_id\",\"canal\"], \"pedidos_app\")\n",
    "\n",
    "assert_columns(lin_pos, [\"order_id\",\"line_num\",\"sku\",\"cantidad\",\"precio_unitario\"], \"lineas_pos\")\n",
    "assert_columns(lin_app, [\"order_id\",\"line_num\",\"sku\",\"cantidad\",\"precio_unitario\"], \"lineas_app\")\n",
    "\n",
    "# Tipos: fechas\n",
    "for df, col, name in [\n",
    "    (clientes, \"fecha_alta\", \"clientes\"),\n",
    "    (ped_pos, \"fecha\", \"pedidos_pos\"),\n",
    "    (ped_app, \"fecha\", \"pedidos_app\"),\n",
    "]:\n",
    "    df[col] = pd.to_datetime(df[col], errors=\"coerce\")\n",
    "    if df[col].isna().any():\n",
    "        bad = df[df[col].isna()].head(5)\n",
    "        raise ValueError(f\"[{name}] Fechas inválidas en '{col}'. Ejemplos:\\n{bad}\")\n",
    "\n",
    "# No nulos en llaves operacionales\n",
    "def assert_not_null(df: pd.DataFrame, cols: list[str], name: str):\n",
    "    for c in cols:\n",
    "        if df[c].isna().any():\n",
    "            raise ValueError(f\"[{name}] Hay nulos en la columna clave: {c}\")\n",
    "\n",
    "assert_not_null(ped_pos, [\"order_id\",\"cliente_id\",\"sucursal_id\"], \"pedidos_pos\")\n",
    "assert_not_null(ped_app, [\"order_id\",\"cliente_id\",\"sucursal_id\"], \"pedidos_app\")\n",
    "assert_not_null(lin_pos, [\"order_id\",\"sku\"], \"lineas_pos\")\n",
    "assert_not_null(lin_app, [\"order_id\",\"sku\"], \"lineas_app\")\n",
    "\n",
    "# Dominios controlados\n",
    "canales_validos = {\"POS\",\"APP\"}\n",
    "if not set(ped_pos[\"canal\"].unique()).issubset(canales_validos):\n",
    "    raise ValueError(f\"[pedidos_pos] Canal fuera de dominio: {set(ped_pos['canal'].unique()) - canales_validos}\")\n",
    "if not set(ped_app[\"canal\"].unique()).issubset(canales_validos):\n",
    "    raise ValueError(f\"[pedidos_app] Canal fuera de dominio: {set(ped_app['canal'].unique()) - canales_validos}\")\n",
    "\n",
    "# Rangos numéricos\n",
    "for df, name in [(lin_pos,\"lineas_pos\"), (lin_app,\"lineas_app\")]:\n",
    "    if (df[\"cantidad\"] <= 0).any():\n",
    "        raise ValueError(f\"[{name}] Se encontraron cantidades <= 0\")\n",
    "    if (df[\"precio_unitario\"] < 0).any():\n",
    "        raise ValueError(f\"[{name}] Se encontraron precios negativos\")\n",
    "\n",
    "print(\"Validaciones mínimas: OK\")"
   ]
