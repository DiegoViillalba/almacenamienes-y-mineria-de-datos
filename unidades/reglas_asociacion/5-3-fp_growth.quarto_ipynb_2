        "def conditional_counts(prefix_paths):\n",
        "    counts = Counter()\n",
        "    for path, weight in prefix_paths:\n",
        "        for item in path:\n",
        "            counts[item] += weight\n",
        "    return counts\n",
        "\n",
        "conditional_counts(prefix_paths_cerveza)"
      ],
