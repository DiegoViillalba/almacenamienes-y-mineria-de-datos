        "))\n",
        "n_nodos = len(nodos)\n",
        "nodo_idx = {nd: i for i, nd in enumerate(nodos)}\n",
        "\n",
        "angulos = [2 * math.pi * i / n_nodos for i in range(n_nodos)]\n",
        "xs = [math.cos(a) for a in angulos]\n",
        "ys = [math.sin(a) for a in angulos]\n",
        "\n",
        "# Centralidad por suma de lifts\n",
