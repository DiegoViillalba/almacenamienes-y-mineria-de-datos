        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Dataset de referencia — idéntico al capítulo anterior para continuidad\n",
        "transacciones_raw = [\n",
        "    [\"whole milk\", \"yogurt\", \"bread\"],\n",
        "    [\"whole milk\", \"butter\", \"eggs\"],\n",
        "    [\"whole milk\", \"yogurt\", \"vegetables\"],\n",
