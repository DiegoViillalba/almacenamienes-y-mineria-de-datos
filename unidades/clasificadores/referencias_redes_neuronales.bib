@article{rumelhart1986learning,
  author  = {David E. Rumelhart and Geoffrey E. Hinton and Ronald J. Williams},
  title   = {Learning Representations by Back-propagating Errors},
  journal = {Nature},
  volume  = {323},
  pages   = {533--536},
  year    = {1986},
  note    = {Introduce el algoritmo de retropropagación (backpropagation) para
             entrenar redes multicapa mediante la regla de la cadena. Es la
             base algorítmica del entrenamiento de practicamente todas las
             redes neuronales modernas.}
}

@book{goodfellow2016deep,
  author    = {Ian Goodfellow and Yoshua Bengio and Aaron Courville},
  title     = {Deep Learning},
  publisher = {MIT Press},
  year      = {2016},
  url       = {https://www.deeplearningbook.org}
}

@article{lecun2015deep,
  author  = {Yann LeCun and Yoshua Bengio and Geoffrey Hinton},
  title   = {Deep Learning},
  journal = {Nature},
  volume  = {521},
  pages   = {436--444},
  year    = {2015},
  note    = {Artículo de revisión en Nature que resume los fundamentos,
             arquitecturas y el impacto del aprendizaje profundo. Referencia
             estándar para introducir el estado del arte de las redes
             neuronales profundas.}
}

@article{lecun1998gradient,
  author  = {Yann LeCun and L{\'e}on Bottou and Yoshua Bengio and Patrick Haffner},
  title   = {Gradient-Based Learning Applied to Document Recognition},
  journal = {Proceedings of the IEEE},
  volume  = {86},
  number  = {11},
  pages   = {2278--2324},
  year    = {1998},
  note    = {Presenta la arquitectura LeNet-5 y los principios de conectividad
             local, compartición de pesos y equivarianza a la traslación que
             fundamentan las redes convolucionales modernas. Referencia
             canónica de las CNN aplicadas a reconocimiento de documentos e
             imágenes.}
}

@article{hornik1989multilayer,
  author  = {Kurt Hornik and Maxwell Stinchcombe and Halbert White},
  title   = {Multilayer Feedforward Networks are Universal Approximators},
  journal = {Neural Networks},
  volume  = {2},
  number  = {5},
  pages   = {359--366},
  year    = {1989},
  note    = {Generaliza el teorema de aproximación universal de Cybenko a una
             clase amplia de funciones de activación no polinomiales.
             Referencia central para justificar por qué una red de una sola
             capa oculta es, en principio, suficientemente expresiva.}
}

@article{cybenko1989approximation,
  author  = {George Cybenko},
  title   = {Approximation by Superpositions of a Sigmoidal Function},
  journal = {Mathematics of Control, Signals, and Systems},
  volume  = {2},
  number  = {4},
  pages   = {303--314},
  year    = {1989},
  note    = {Demuestra el teorema de aproximación universal para redes con
             activación sigmoidal: una capa oculta con suficientes unidades
             puede aproximar cualquier función continua en un conjunto
             compacto. Fundamenta teóricamente la capacidad expresiva de las
             redes neuronales.}
}

@inproceedings{kingma2015adam,
  author    = {Diederik P. Kingma and Jimmy Ba},
  title     = {Adam: A Method for Stochastic Optimization},
  booktitle = {International Conference on Learning Representations (ICLR)},
  year      = {2015},
  note      = {Presenta el optimizador Adam (Adaptive Moment Estimation), que
               combina momentum con adaptación por coordenada de la tasa de
               aprendizaje mediante estimaciones de primer y segundo momento
               del gradiente. Es el optimizador por defecto en la mayoría de
               las arquitecturas de aprendizaje profundo actuales.}
}

@article{srivastava2014dropout,
  author  = {Nitish Srivastava and Geoffrey Hinton and Alex Krizhevsky and Ilya Sutskever and Ruslan Salakhutdinov},
  title   = {Dropout: A Simple Way to Prevent Neural Networks from Overfitting},
  journal = {Journal of Machine Learning Research},
  volume  = {15},
  pages   = {1929--1958},
  year    = {2014},
  note    = {Propone Dropout, una técnica de regularización que desactiva
             neuronas aleatoriamente durante el entrenamiento para prevenir el
             sobreajuste. Una de las técnicas de regularización más utilizadas
             en redes neuronales profundas.}
}

@article{hochreiter1997long,
  author  = {Sepp Hochreiter and J{\"u}rgen Schmidhuber},
  title   = {Long Short-Term Memory},
  journal = {Neural Computation},
  volume  = {9},
  number  = {8},
  pages   = {1735--1780},
  year    = {1997},
  note    = {Introduce la arquitectura LSTM (Long Short-Term Memory), que
             resuelve el desvanecimiento del gradiente en secuencias largas
             mediante un mecanismo de compuertas y una celda de memoria.
             Referencia fundacional para el modelado de secuencias con redes
             recurrentes.}
}

@inproceedings{vaswani2017attention,
  author    = {Ashish Vaswani and Noam Shazeer and Niki Parmar and Jakob Uszkoreit and Llion Jones and Aidan N. Gomez and Lukasz Kaiser and Illia Polosukhin},
  title     = {Attention Is All You Need},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  volume    = {30},
  year      = {2017},
  note      = {Introduce la arquitectura Transformer y el mecanismo de
               autoatención (self-attention), eliminando la recurrencia y
               permitiendo el procesamiento paralelo de secuencias. Referencia
               fundacional de los modelos de lenguaje modernos.}
}
