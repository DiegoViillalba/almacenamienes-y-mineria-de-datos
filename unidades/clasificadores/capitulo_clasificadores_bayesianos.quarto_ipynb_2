        "def norm_ppf(p):\n",
        "    \"\"\"Aproximación del cuantil normal estándar para 0 < p < 1.\"\"\"\n",
        "    p = np.clip(p, 1e-10, 1 - 1e-10)\n",
        "    sign = np.where(p < 0.5, -1.0, 1.0)\n",
