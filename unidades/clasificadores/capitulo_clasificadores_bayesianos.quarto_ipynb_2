        "#| echo: true\n",
        "#| code-fold: false\n",
        "import numpy as np\n",
        "\n",
        "def clasificador_bayesiano(verosimilitudes, priors, clases):\n",
        "    \"\"\"\n",
        "    Clasificador bayesiano para cualquier número de clases.\n",
