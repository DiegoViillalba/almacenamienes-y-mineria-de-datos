        "    losses.append(l)\n",
        "    acc = float(np.mean(mlp.predict(X_moons) == y_moons))\n",
        "    accuracies.append(acc)\n",
        "    grads = mlp.backward(y_moons)\n",
        "    mlp.step(grads)\n",
        "\n",
        "# Store trained mlp for next figure\n",
        "trained_mlp = mlp\n",
        "\n",
