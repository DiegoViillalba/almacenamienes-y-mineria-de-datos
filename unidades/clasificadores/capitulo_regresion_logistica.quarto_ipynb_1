        "#| label: fig-logit-failure\n",
        "#| fig-cap: Regresión lineal aplicada a un problema de clasificación binaria. La recta ajustada produce predicciones fuera del intervalo [0, 1] y no respeta la naturaleza probabilística de la variable respuesta.\n",
        "\n",
        "import numpy as np\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "n0, n1 = 40, 40\n",
