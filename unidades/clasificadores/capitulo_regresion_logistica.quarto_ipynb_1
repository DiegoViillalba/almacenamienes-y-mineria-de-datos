        "x1_extra = np.array([9.5, 10.5, 11.0])\n",
        "x_all = np.concatenate([x0, x1, x1_extra])\n",
        "y_all = np.concatenate([np.zeros(n0), np.ones(n1), np.ones(3)])\n",
