        "    ctx.strokeStyle='#9aa3b5';ctx.lineWidth=1.2;\n",
        "    ctx.beginPath();ctx.moveTo(PL,PT);ctx.lineTo(PL,PT+PH);ctx.lineTo(PL+PW,PT+PH);ctx.stroke();\n",
        "    ctx.fillStyle='#888';ctx.font='11px Georgia,serif';ctx.textAlign='center';\n",
