        "    for(let gy=0;gy<=5;gy++){ctx.beginPath();ctx.moveTo(PL,sy(gy));ctx.lineTo(PL+PW,sy(gy));ctx.stroke();}\n",
        "\n",
        "    /* axes */\n",
        "    ctx.strokeStyle='#9aa3b5';ctx.lineWidth=1.2;\n",
