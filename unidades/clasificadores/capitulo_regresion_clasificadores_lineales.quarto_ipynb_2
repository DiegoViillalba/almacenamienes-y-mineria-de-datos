        "    ctx.lineWidth=0.8; ctx.strokeStyle='rgba(100,120,160,0.35)';\n",
        "    [...C1,...C2].forEach(p=>{\n",
        "      const {fx,fy}=footScreen(p);\n",
        "      ctx.beginPath();ctx.moveTo(sx(p[0]),sy(p[1]));ctx.lineTo(fx,fy);ctx.stroke();\n",
        "    });\n",
        "\n",
        "    /* data points */\n",
        "    function drawPts(pts,col){\n",
