        "\n",
        "    /* tick labels */\n",
        "    ctx.fillStyle='#888';ctx.font='11px Georgia,serif';ctx.textAlign='center';\n",
        "    for(let gx=0;gx<=6;gx++) ctx.fillText(gx,sx(gx),PT+PH+14);\n",
