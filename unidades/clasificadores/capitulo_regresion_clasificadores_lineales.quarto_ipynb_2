        "<script>\n",
        "(function(){\n",
        "  /* ── datos ─────────────────────────────────────────────── */\n",
        "  const C1=[[-0.11,1.68],[0.68,2.39],[1.29,1.52],[1.54,2.71],[2.18,1.94],\n",
