        "    {x:[0.9,2.0],y:1},{x:[1.2,0.4],y:1},\n",
        "    {x:[3.5,3.2],y:-1},{x:[4.0,3.8],y:-1},{x:[3.2,4.0],y:-1},\n",
        "    {x:[4.2,3.0],y:-1},{x:[3.8,4.2],y:-1},{x:[3.0,3.6],y:-1},\n",
