        "\n",
        "m1 = X1.mean(axis=0)\n",
        "m2 = X2.mean(axis=0)\n",
        "\n",
        "S1 = (X1 - m1).T @ (X1 - m1)\n",
        "S2 = (X2 - m2).T @ (X2 - m2)\n",
        "SW = S1 + S2\n",
        "\n",
        "w = np.linalg.pinv(SW) @ (m1 - m2)\n",
        "w = w / np.linalg.norm(w)\n",
