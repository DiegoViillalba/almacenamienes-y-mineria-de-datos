        "      ctx.beginPath();ctx.moveTo(SC.l,sy(gy));ctx.lineTo(SC.l+SCW,sy(gy));ctx.stroke();\n",
        "    }\n",
        "    /* axes */\n",
        "    ctx.strokeStyle='#9aa3b5'; ctx.lineWidth=1.2;\n",
