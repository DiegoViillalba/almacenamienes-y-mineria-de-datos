        "    for(let gx=Math.ceil(xMn);gx<=xMx;gx++){\n",
        "      ctx.beginPath();ctx.moveTo(sx(gx),SC.t);ctx.lineTo(sx(gx),SC.t+SCH);ctx.stroke();\n",
        "    }\n",
