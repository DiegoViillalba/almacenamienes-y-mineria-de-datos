        "    const sx = f.x + dx/len*rf,  sy = f.y + dy/len*rf;\n",
        "    const ex = t.x - dx/len*rt,  ey = t.y - dy/len*rt;\n",
        "\n",
        "    svg.appendChild(mk('line', {\n",
        "      x1:sx, y1:sy, x2:ex, y2:ey,\n",
        "      stroke:'#8899bb', 'stroke-width':1.6,\n",
        "      'marker-end':'url(#arr)'\n",
        "    }));\n",
        "\n",
        "    // Edge label background + text\n",
