        "\n",
        "function drawTree(step) {\n",
        "  svg.innerHTML = '';\n",
        "  const {vN, vE, hl} = step;\n",
        "\n",
        "  // defs for arrowhead\n",
        "  const defs = mk('defs', {});\n",
