      "source": [
        "import numpy as np\n",
        "\n",
        "def entropy(labels):\n",
        "    values, counts = np.unique(labels, return_counts=True)\n",
        "    probs = counts / counts.sum()\n",
        "    return -np.sum(probs * np.log2(probs))\n",
        "\n",
        "labels = [\"Sí\"] * 9 + [\"No\"] * 6\n",
        "entropy(labels)"
      ],
