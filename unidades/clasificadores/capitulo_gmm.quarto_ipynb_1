        "#| label: fig-gmm-2d-densidad\n",
        "#| fig-cap: Densidad de una mezcla gaussiana con K=3 componentes en 2D. Los contornos rellenos muestran la densidad conjunta de la mezcla; los puntos coloreados representan las observaciones asignadas a cada componente.\n",
        "#| code-fold: true\n",
        "\n",
        "import numpy as np\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "rng2 = np.random.default_rng(7)\n",
        "\n",
        "# Parametros de los 3 componentes\n",
