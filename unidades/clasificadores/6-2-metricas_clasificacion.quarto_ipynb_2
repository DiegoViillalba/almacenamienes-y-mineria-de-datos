      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ── AUC alto pero F1 bajo en el umbral operativo ───────────────────────────\n",
        "# Modelo bien rankeado pero con probabilidades mal calibradas\n",
        "np.random.seed(99)\n",
