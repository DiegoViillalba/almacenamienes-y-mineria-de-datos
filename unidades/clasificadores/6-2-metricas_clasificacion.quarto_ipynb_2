        "\n",
        "print(\"Matriz de confusión — Regresión Logística (médico):\")\n",
        "print(cm_lr)\n",
        "print(f\"\\nTP={TP}, TN={TN}, FP={FP}, FN={FN}\")\n",
        "\n",
        "fig_cm = plot_confusion_matrix(\n",
        "    cm_lr,\n",
        "    # titulo=\"Matriz de Confusión — Clasificador Médico (Reg. Logística)\",\n",
        "    etiquetas=[\"Sano\", \"Enfermo\"],\n",
        ")\n",
        "fig_cm.show()"
