        "fpr_fk, tpr_fk, _ = roc_curve(y_te_m, y_fake_prob)\n",
        "auc_fk = auc(fpr_fk, tpr_fk)\n",
        "\n",
        "print(\"Modelo con AUC alto pero mal calibrado (F1 bajo al umbral default):\")\n",
        "print(f\"  AUC             : {auc_fk:.4f}\")\n",
