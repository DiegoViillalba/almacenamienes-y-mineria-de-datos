        "print()\n",
        "print(\"Conclusión: el AUC mide capacidad de ranking, no desempeño operativo.\")\n",
        "print(\"Validar siempre las métricas en el umbral de producción.\")\n",
        "print(\"(Fawcett, 2006)\")"
