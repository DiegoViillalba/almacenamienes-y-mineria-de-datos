      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "#| label: ex-jax-hessian\n",
        "\n",
        "import jax\n",
        "import jax.numpy as jnp\n",
        "import numpy as np\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "def bce_escalar(w):\n",
        "    \"\"\"\n",
        "    Binary Cross-Entropy para un solo peso escalar.\n",
        "    Con entrada fija x=1 y etiqueta y=1.\n",
        "    \"\"\"\n",
        "    sigma = jax.nn.sigmoid(w)\n",
