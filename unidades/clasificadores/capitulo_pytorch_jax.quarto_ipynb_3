        "# ---- Data: channels-last (N, H, W, C) for Flax ----\n",
        "digits = load_digits()\n",
        "X_dig_f = digits.data.astype(np.float32) / 16.0\n",
        "y_dig_f = digits.target.astype(np.int32)\n",
        "\n",
        "rng_f = np.random.RandomState(42)\n",
        "idx_f = rng_f.permutation(len(X_dig_f))\n",
